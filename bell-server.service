[Unit]
Description=School Bell System - Flask Web Interface
After=network.target

[Service]
Type=simple
User=admins
WorkingDirectory=/home/admins/colegio
ExecStart=/usr/bin/python3 /home/admins/colegio/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# NOTA: Este archivo es un template con paths absolutos.
# Para regenerarlo con los paths correctos de tu máquina, ejecuta:
#   python3 setup_service.py --install
# (requiere sudo para instalar en /etc/systemd/system/)